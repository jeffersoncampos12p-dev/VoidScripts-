-- Utilitário HSV
local function HSVtoRGB(h, s, v)
    h = (h % 1) * 6
    local i = math.floor(h)
    local f = h - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    if i == 0 then return Color3.new(v, t, p)
    elseif i == 1 then return Color3.new(q, v, p)
    elseif i == 2 then return Color3.new(p, v, t)
    elseif i == 3 then return Color3.new(p, q, v)
    elseif i == 4 then return Color3.new(t, p, v)
    else return Color3.new(v, p, q) end
end

local function getActiveColor()
    if Settings.HighlightMode == "Red" then return Color3.fromRGB(255,0,0)
    elseif Settings.HighlightMode == "Rainbow" then return HSVtoRGB(tick()*2%1,1,1)
    end
    return Color3.fromRGB(255,255,255)
end

-- ESP
local function createDrawings(p)
    local box, tracer
    pcall(function() box = Drawing.new("Square"); box.Visible=false; box.Filled=false; box.Thickness=1.5 end)
    pcall(function() tracer = Drawing.new("Line"); tracer.Visible=false; tracer.Thickness=1 end)
    if box and tracer then playerDrawings[p] = {box=box, tracer=tracer} end
end

local function removeDrawings(p)
    local d = playerDrawings[p]
    if d then pcall(function() d.box:Remove() end) pcall(function() d.tracer:Remove() end) playerDrawings[p]=nil end
    local lines = playerSkeletonLines[p]
    if lines then
        for _, line in ipairs(lines) do pcall(function() line:Remove() end) end
        playerSkeletonLines[p] = nil
    end
end

local function updateESP()
    local color = getActiveColor()
    local start = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
    for p, d in pairs(playerDrawings) do
        local char = p.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")
            if root and head and hum and hum.Health>0 then
                local rp, rv = Camera:WorldToViewportPoint(root.Position)
                local hp, hv = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                if rv or hv then
                    if Settings.Box then
                        local h = math.abs(hp.Y - rp.Y)
                        local w = h*0.65
                        d.box.Visible = true
                        d.box.Position = Vector2.new(rp.X - w/2, rp.Y)
                        d.box.Size = Vector2.new(w,h)
                        d.box.Color = color
                    else d.box.Visible = false end
                    if Settings.Tracer then
                        d.tracer.Visible = true
                        d.tracer.From = start
                        d.tracer.To = Vector2.new(rp.X, rp.Y)
                        d.tracer.Color = color
                    else d.tracer.Visible = false end
                end

                -- Skeleton ESP
                if Settings.Skeleton then
                    if not playerSkeletonLines[p] then
                        playerSkeletonLines[p] = {}
                        for i = 1, #skeletonConnections do
                            local line = Drawing.new("Line")
                            line.Visible = false
                            line.Thickness = 1
                            line.Color = color
                            table.insert(playerSkeletonLines[p], line)
                        end
                    end
                    local lines = playerSkeletonLines[p]
                    local foundParts = {}
                    for _, bone in ipairs(skeletonBones) do
                        foundParts[bone[1]] = getPart(char, bone[2])
                    end
                    for i, conn in ipairs(skeletonConnections) do
                        local partA = foundParts[conn[1]]
                        local partB = foundParts[conn[2]]
                        if partA and partB then
                            local posA, onA = Camera:WorldToViewportPoint(partA.Position)
                            local posB, onB = Camera:WorldToViewportPoint(partB.Position)
                            if onA or onB then
                                lines[i].Visible = true
                                lines[i].From = Vector2.new(posA.X, posA.Y)
                                lines[i].To = Vector2.new(posB.X, posB.Y)
                                lines[i].Color = color
                            else lines[i].Visible = false end
                        else lines[i].Visible = false end
                    end
                else
                    local lines = playerSkeletonLines[p]
                    if lines then for _, line in ipairs(lines) do line.Visible = false end end
                end
            else
                d.box.Visible = false; d.tracer.Visible = false
                local lines = playerSkeletonLines[p]
                if lines then for _, line in ipairs(lines) do line.Visible = false end end
            end
        else
            d.box.Visible = false; d.tracer.Visible = false
            local lines = playerSkeletonLines[p]
            if lines then for _, line in ipairs(lines) do line.Visible = false end end
        end
    end
end

-- Aimbot
local function findBestTarget()
    local center = Camera.ViewportSize/2
    local best, bestDist = nil, Settings.FOVRadius
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end
        local part = nil
        if Settings.AimPart=="Head" then part=char:FindFirstChild("Head")
        elseif Settings.AimPart=="Torso" then part=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        elseif Settings.AimPart=="HumanoidRootPart" then part=char:FindFirstChild("HumanoidRootPart")
        elseif Settings.AimPart=="Neck" then part=char:FindFirstChild("Neck") or char:FindFirstChild("Head")
        end
        if not part then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d2 = (Vector2.new(sp.X, sp.Y)-center).Magnitude
        if d2 > Settings.FOVRadius then continue end
        local d3 = (part.Position - Camera.CFrame.Position).Magnitude
        if d3 > Settings.MaxDistance then continue end
        if d2 < bestDist then bestDist=d2; best=p end
    end
    return best
end
local function getAimPos(p)
    local char = p.Character if not char then return end
    if Settings.AimPart=="Head" then return char:FindFirstChild("Head") and char.Head.Position
    elseif Settings.AimPart=="Torso" then
        local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") return t and t.Position
    elseif Settings.AimPart=="HumanoidRootPart" then return char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position
    elseif Settings.AimPart=="Neck" then
        local neck = char:FindFirstChild("Neck")
        if neck and neck.Parent and neck.Parent:FindFirstChild("Head") then
            return neck.Parent.Head.Position + (neck.Parent.Head.Position - neck.Position).Unit*0.5
        end
        return char:FindFirstChild("Head") and char.Head.Position
    end
end
local function updateAimbot()
    if not Settings.Aimbot then return end
    local t = findBestTarget()
    if t then
        local pos = getAimPos(t)
        if pos then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), 1 - Settings.AimSmoothness)
        end
    end
end
local function updateFOV()
    if not fovCircle then return end
    fovCircle.Visible = Settings.ShowFOV
    if Settings.ShowFOV then
        fovCircle.Position = Camera.ViewportSize/2
        fovCircle.Radius = Settings.FOVRadius
    end
end

-- Hitbox
local function applyHitbox(char, mul)
    if not char then return end
    local hum = char:FindFirstChild("Humanoid") if not hum or hum.Health<=0 then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
            if not originalSizes[p] then originalSizes[p] = p.Size end
            p.Size = originalSizes[p] * mul
        end
    end
end
local function restoreHitbox(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and originalSizes[p] then
            p.Size = originalSizes[p]; originalSizes[p]=nil
        end
    end
end
local function refreshHitboxes()
    if Settings.HitboxExpander then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then applyHitbox(p.Character, Settings.HitboxSize) end
        end
    else
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then restoreHitbox(p.Character) end
        end
    end
end

-- Conexões de jogadores
for _,p in ipairs(Players:GetPlayers()) do
    if p~=LocalPlayer then
        createDrawings(p)
        if Settings.HitboxExpander and p.Character then applyHitbox(p.Character, Settings.HitboxSize) end
        p.CharacterAdded:Connect(function(c) if Settings.HitboxExpander then applyHitbox(c, Settings.HitboxSize) end end)
    end
end
Players.PlayerAdded:Connect(function(p)
    if p~=LocalPlayer then
        createDrawings(p)
        if Settings.HitboxExpander and p.Character then applyHitbox(p.Character, Settings.HitboxSize) end
        p.CharacterAdded:Connect(function(c) if Settings.HitboxExpander then applyHitbox(c, Settings.HitboxSize) end end)
    end
end)
Players.PlayerRemoving:Connect(function(p)
    removeDrawings(p)
    if p.Character then restoreHitbox(p.Character) end
end)

